{
  "manifest_version": 3,
  "name": "house-recon companion",
  "version": "0.2.0",
  "description": "One click fetches a home's listing, market, and sold-comps pages into the house-recon analyzer. Everything stays in your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://zillow.com/*",
    "https://www.redfin.com/*",
    "https://redfin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://reggie-reuss.github.io/house-recon/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

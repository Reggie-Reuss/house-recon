# Analysis output — contains addresses and owner names; gitignored BY DESIGN.
# Do not weaken this rule in a public fork.
reports/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Captured media and intermediate data
*.png
*.jpg
*_next.json

# Text dumps (but keep requirements.txt)
*.txt
!requirements.txt

# OS / scratch
.DS_Store
scratch/

# Validation harness page captures (bulky; contain listing addresses)
validation/raw/

# Exceptions: synthetic demo inputs and site screenshots (fictional data
# only -- generated by examples/make_demo.py and the shots harness)
!examples/**/*.txt
!docs/assets/*.png

# Companion extension: icons ship with the extension; the store zip is built
!extension/icons/*.png
extension/house-recon-companion.zip

# Cloudflare Worker local dev cache
.wrangler/

# Personal per-machine config (utility providers for your own area) — BY
# DESIGN untracked in this public repo; see _local_utilities() in the CLI.
local_utilities.json
